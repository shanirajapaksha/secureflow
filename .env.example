# Backend
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_UPLOAD_BYTES=10485760
MAX_CSV_ROWS=100000
MIN_FEATURE_COVERAGE=0.80
MAX_RECENT_ALERTS=500
CONVERTER_TIMEOUT_SECONDS=180

DATABASE_URL=postgresql://secureflow_user:your_password@localhost:5432/secureflow_ai
FIREWALL_ENFORCEMENT=true

